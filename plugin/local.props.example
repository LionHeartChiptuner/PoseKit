<Project>
  <!--
    Copy this file to local.props (it's git-ignored) and fill in your own paths.
    The project file imports it automatically.
  -->
  <PropertyGroup>
    <!-- Folder containing h3vr.exe -->
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\H3VR</GameDir>
    <!-- Mod profile folder containing BepInEx\ (with GlovesTan3 and Sodalite installed) -->
    <ProfileDir>$(APPDATA)\r2modmanPlus-local\H3VR\profiles\Default</ProfileDir>
  </PropertyGroup>
</Project>
